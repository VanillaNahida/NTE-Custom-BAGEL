#include "resource.h"
#include <winver.h>

IDI_APPICON ICON "AppIcon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,3,0
 PRODUCTVERSION  1,0,3,0
 FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
 FILEFLAGS       VS_FF_DEBUG
#else
 FILEFLAGS       0x0
#endif
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "VanillaNahida"
            VALUE "FileVersion", "1.0.3.0"
            VALUE "LegalCopyright", "Copyright (C) VanillaNahida"
            VALUE "ProductVersion", "1.0.3.0"
            VALUE "Author", "VanillaNahida"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 0x04B0
    END
END
